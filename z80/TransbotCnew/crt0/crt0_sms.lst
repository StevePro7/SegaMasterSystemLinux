                                     34 ;  not however invalidate any other reasons why the executable file
                                     35 ;  might be covered by the GNU General Public License.
                                     36 ;--------------------------------------------------------------------------
                                     37 
                                     38         .module crt0
                                     39         .globl _main
                                     40 
                                     41         .area _HEADER (ABS)
      000000                         42         .org    0                       ; Reset 00h
      000000 F3               [ 4]   43         di                              ; disable interrupt
      000001 ED 56            [ 8]   44         im 1                            ; interrupt mode 1 (this will never change)
      000003 31 F0 DF         [10]   45         ld sp, #0xdff0                  ; set stack pointer at end of RAM
      000006 18p21            [12]   46         jr crt0_init
                                     47 ;--------------------------------------------------------------------------
      000008                         48         .org    0x08                    ; Reset 08h - write HL to VDP Control Port
      000008                         49 _SMS_crt0_RST08::
      000008 0E BF            [ 7]   50         ld c, #0xBF                     ; set VDP Control Port
      00000A F3               [ 4]   51         di                              ; make it interrupt SAFE
      00000B ED 69            [12]   52         out (c),l
      00000D ED 61            [12]   53         out (c),h
      00000F FB               [ 4]   54         ei
      000010 C9               [10]   55         ret
                                     56 ;--------------------------------------------------------------------------
      000018                         57         .org    0x18                    ; Reset 18h - write HL to VDP Data Port
      000018                         58 _SMS_crt0_RST18::
      000018 7D               [ 4]   59         ld a,l                          ; (respecting VRAM time costraints)
      000019 D3 BE            [11]   60         out (#0xBE),a                   ; 11
      00001B 7C               [ 4]   61         ld a,h                          ; 4
      00001C 23               [ 6]   62         inc hl                          ; 6
      00001D 2B               [ 6]   63         dec hl                          ; 6 = 27 (VRAM SAFE on every GameGear)
      00001E D3 BE            [11]   64         out (#0xBE),a
      000020 C9               [10]   65         ret
                                     66 ;--------------------------------------------------------------------------
      000021                         67 crt0_init:
      000021 21 00 00         [10]   68         ld hl,#0x0000                   ; initialize mappers
      000024 22 FC FF         [16]   69         ld (#0xfffc),hl                 ; [0xfffc]=$00, [0xfffd]=$00
      000027 21 01 02         [10]   70         ld hl,#0x0201
      00002A 22 FE FF         [16]   71         ld (#0xfffe),hl                 ; [0xfffe]=$01, [0xffff]=$02
      00002D 18p3B            [12]   72         jr crt0_clear_ram
                                     73 ;--------------------------------------------------------------------------
      00002F                         74 get_bank::                              ; get current code bank num into A
      00002F 3A FE FF         [13]   75         ld a,(#0xfffe)                  ; (read current page from mapper)
      000032 C9               [10]   76         ret
      000033                         77 set_bank::                              ; set current code bank num to A
      000033 32 FE FF         [13]   78         ld (#0xfffe),a                  ; (restore caller page)
      000036 C9               [10]   79         ret
                                     80 ;--------------------------------------------------------------------------
      000038                         81         .org    0x38                    ; handle IRQ
      000038 C3r00r00         [10]   82         jp _SMS_isr
                                     83 ;--------------------------------------------------------------------------
      00003B                         84 crt0_clear_ram:
      00003B 21 00 C0         [10]   85         ld hl,#0xc000                   ; save contents of $c000
      00003E 7E               [ 7]   86         ld a,(hl)                       ;   before clearing RAM
      00003F 06 00            [ 7]   87         ld b,#0x00                      ; clear RAM (to value 0x00) by setting
      000041 70               [ 7]   88         ld (hl),b                       ;   value 0 to $c000 and
      000042 11 01 C0         [10]   89         ld de,#0xc001                   ;   copying (LDIR) it to next byte
      000045 01 EE 1E         [10]   90         ld bc,#0x1eee                   ;   $C001-$DFEE (the stack at $DFF0 is not touched)
      000048 ED B0            [21]   91         ldir                            ;   do that
      00004A 32r00r00         [13]   92         ld (_SMS_Port3EBIOSvalue),a     ; restore contents of $c000 to SMS_Port3EBIOSvalue var
                                     93 
                                     94         ;; Initialise global variables
      00004D CDr00r00         [17]   95         call crt0_gsinit
      000050 CDr00r00         [17]   96         call _SMS_init
      000053 FB               [ 4]   97         ei                              ; re-enable interrupts before going to main()
      000054 CDr00r00         [17]   98         call _main
      000057                         99 1$:
      000057 76               [ 4]  100         halt
      000058 18 FD            [12]  101         jr 1$
                                    102 ;--------------------------------------------------------------------------
      00005A 64 65 76 6B 69 74 53   103         .ascii 'devkitSMS'              ; this is shameless
             4D 53
                                    104 ;--------------------------------------------------------------------------
      000066                        105         .org     0x66                   ; handle NMI
      000066 C3r00r00         [10]  106         jp _SMS_nmi_isr
                                    107 ;--------------------------------------------------------------------------
                                    108         ; here is a block of 128 OUTI instructions, made for enabling
                                    109         ; UNSAFE but FAST short data transfers to VRAM
                                    110 ;--------------------------------------------------------------------------
      000069                        111 _OUTI128::                              ; _OUTI128 label points to a block of 128 OUTI and a RET
                                    112         .rept 32
                                    113         outi
                                    114         .endm
