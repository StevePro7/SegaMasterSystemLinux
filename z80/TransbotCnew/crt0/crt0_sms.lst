                                    130         ;; Ordering of segments for the linker.
                                    131         .area   _HOME
                                    132         .area   _CODE
                                    133         .area   _INITIALIZER
                                    134         .area   _GSINIT
                                    135         .area   _GSFINAL
                                    136 
                                    137         .area   _DATA
                                    138         .area   _INITIALIZED
                                    139         .area   _BSEG
                                    140         .area   _BSS
                                    141         .area   _HEAP
                                    142 
                                    143         .area   _CODE
                                    144         .area   _GSINIT
      000000                        145 crt0_gsinit::
      000000 01r00r00         [10]  146         ld bc, #l__INITIALIZER
      000003 78               [ 4]  147         ld a, b
      000004 B1               [ 4]  148         or a, c
      000005 28 08            [12]  149         jr Z, crt0_gsinit_next
      000007 11r00r00         [10]  150         ld de, #s__INITIALIZED
      00000A 21r00r00         [10]  151         ld hl, #s__INITIALIZER
      00000D ED B0            [21]  152         ldir
      00000F                        153 crt0_gsinit_next:
                                    154         .area   _GSFINAL
      000000 C9               [10]  155         ret
